DEF ROBOT Robot {
  translation -1.2 -1.2 0.03
  rotation 0 0 1 0.785
  children [
    DEF BODY_SHAPE Pose {
      translation 0 0 0.02
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.1 0.3 0.8
            roughness 1
            metalness 0
          }
          geometry Box {
            size 0.16 0.12 0.04
          }
        }
      ]
    }
    Pose {
      translation 0.075 0 0.03
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 1 1 1
            roughness 1
            metalness 0
          }
          geometry Box {
            size 0.012 0.1 0.012
          }
        }
      ]
    }
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0 0.07 0
      }
      device [
        RotationalMotor {
          name "motor_kiri"
          maxVelocity 15
        }
        PositionSensor {
          name "encoder_kiri"
        }
      ]
      endPoint Solid {
        translation 0 0.07 0
        rotation 1 0 0 1.5708
        children [
          DEF RODA_SHAPE Shape {
            appearance PBRAppearance {
              baseColor 0.1 0.1 0.1
              roughness 1
              metalness 0
            }
            geometry Cylinder {
              height 0.02
              radius 0.03
            }
          }
        ]
        name "roda_kiri"
        boundingObject USE RODA_SHAPE
        physics Physics {
          density -1
          mass 0.05
        }
      }
    }
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0 -0.07 0
      }
      device [
        RotationalMotor {
          name "motor_kanan"
          maxVelocity 15
        }
        PositionSensor {
          name "encoder_kanan"
        }
      ]
      endPoint Solid {
        translation 0 -0.07 0
        rotation 1 0 0 1.5708
        children [
          USE RODA_SHAPE
        ]
        name "roda_kanan"
        boundingObject USE RODA_SHAPE
        physics Physics {
          density -1
          mass 0.05
        }
      }
    }
    BallJoint {
      jointParameters BallJointParameters {
        anchor -0.06 0 -0.015
      }
      endPoint Solid {
        translation -0.06 0 -0.015
        children [
          DEF KASTOR_SHAPE Shape {
            appearance PBRAppearance {
              baseColor 0.8 0.8 0.8
              roughness 1
              metalness 0
            }
            geometry Sphere {
              radius 0.015
            }
          }
        ]
        name "roda_kastor"
        boundingObject USE KASTOR_SHAPE
        physics Physics {
          density -1
          mass 0.01
        }
      }
    }
    Lidar {
      translation 0 0 0.065
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.9 0.1 0.1
            roughness 1
            metalness 0
          }
          geometry Cylinder {
            height 0.03
            radius 0.02
          }
        }
      ]
      name "lidar"
      horizontalResolution 360
      fieldOfView 6.2832
      verticalFieldOfView 0.05
      numberOfLayers 1
      near 0.025
      minRange 0.03
      maxRange 2.5
      projection "cylindrical"
      noise 0.002
    }
    DistanceSensor {
      translation 0.08 0.04 0.02
      rotation 0 0 1 0.6
      name "us_kiri"
      lookupTable [
        0 0 0
        1 1 0
      ]
      type "sonar"
      aperture 0.3
    }
    DistanceSensor {
      translation 0.081 0 0.02
      name "us_depan"
      lookupTable [
        0 0 0
        1 1 0
      ]
      type "sonar"
      aperture 0.3
    }
    DistanceSensor {
      translation 0.08 -0.04 0.02
      rotation 0 0 1 -0.6
      name "us_kanan"
      lookupTable [
        0 0 0
        1 1 0
      ]
      type "sonar"
      aperture 0.3
    }
  ]
  name "robot_b401"
  boundingObject Pose {
    translation 0 0 0.02
    children [
      Box {
        size 0.16 0.12 0.04
      }
    ]
  }
  physics Physics {
    density -1
    mass 0.6
    centerOfMass [
      -0.02 0 0.01
