Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 12
      Color: 160; 160; 164
      Alpha: 0.35
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/LaserScan
      Name: Lidar (jejak 30 s)
      Enabled: true
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Decay Time: 30
      Style: Points
      Size (Pixels): 2
      Color Transformer: FlatColor
      Color: 120; 170; 255
      Alpha: 0.6
    - Class: rviz_default_plugins/LaserScan
      Name: Lidar (scan sekarang)
      Enabled: true
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Decay Time: 0
      Style: Spheres
      Size (m): 0.025
      Color Transformer: FlatColor
      Color: 255; 60; 60
      Alpha: 1
    - Class: rviz_default_plugins/Odometry
      Name: Lintasan (odom)
      Enabled: true
      Topic:
        Value: /odom
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Keep: 300
      Position Tolerance: 0.05
      Angle Tolerance: 0.3
      Shape:
        Value: Arrow
        Color: 255; 200; 60
        Alpha: 0.8
        Shaft Length: 0.06
        Shaft Radius: 0.006
        Head Length: 0.025
        Head Radius: 0.015
      Covariance:
        Value: false
    - Class: rviz_default_plugins/MarkerArray
      Name: Keputusan robot
      Enabled: true
      Topic:
        Value: /oa/decision
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Arrows: false
      Marker Scale: 0.4
  Global Options:
    Background Color: 30; 34; 42
    Fixed Frame: odom
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 180
      X: 0.8
      Y: 0.8
      Angle: 0
      Near Clip Distance: 0.01
      Target Frame: <Fixed Frame>
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Width: 1440
  X: 60
  Y: 60
  Hide Left Dock: false
  Hide Right Dock: true
